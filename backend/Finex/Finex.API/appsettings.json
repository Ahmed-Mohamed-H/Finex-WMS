{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ApiSecurity": {
    "CurrentSecret": "",
    "PreviousSecret": "",
    "AllowedClockSkewSeconds": 60,
    "MaxPayloadBytes": 1048576
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341",
    "ApiKey": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq", "Serilog.Enrichers.Span" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "ZiggyCreatures.Caching.Fusion": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithSpan", "WithMachineName", "WithThreadId", "WithEnvironment" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({SourceContext}) {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "Finex.WMS.API"
    }
  },
  "AllowedHosts": "*"
}